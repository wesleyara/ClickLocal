generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Board {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  columns       BoardColumn[]
  tags          Tag[]
  adoConnection AzureDevOpsConnection?

  @@map("boards")
}

model BoardColumn {
  id               Int      @id @default(autoincrement())
  boardId          Int      @map("board_id")
  name             String
  color            String   @default("#6d5ce8")
  position         Int
  adoStateCategory String?  @map("ado_state_category")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@map("board_columns")
}

model Card {
  id          Int       @id @default(autoincrement())
  columnId    Int       @map("column_id")
  parentId    Int?      @map("parent_id")
  title       String
  description String?
  position    Int
  dueDate     DateTime? @map("due_date")
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  column      BoardColumn        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  parent      Card?              @relation("CardChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Card[]             @relation("CardChildren")
  subtasks    Subtask[]
  tags        CardTag[]
  timeEntries TimeEntry[]
  activity    ActivityLogEntry[]
  comments    Comment[]
  attachments Attachment[]
  ado         AdoWorkItem?

  @@map("cards")
}

model Attachment {
  id         Int      @id @default(autoincrement())
  cardId     Int      @map("card_id")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  size       Int
  storageKey String   @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Comment {
  id           Int      @id @default(autoincrement())
  cardId       Int      @map("card_id")
  body         String
  adoCommentId Int?     @map("ado_comment_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Subtask {
  id        Int      @id @default(autoincrement())
  cardId    Int      @map("card_id")
  title     String
  completed Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("subtasks")
}

model Tag {
  id        Int      @id @default(autoincrement())
  boardId   Int      @map("board_id")
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at")

  board Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardTag[]

  @@map("tags")
}

model CardTag {
  cardId Int @map("card_id")
  tagId  Int @map("tag_id")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@map("card_tags")
}

model TimeEntry {
  id          Int       @id @default(autoincrement())
  cardId      Int       @map("card_id")
  startedAt   DateTime  @map("started_at")
  endedAt     DateTime? @map("ended_at")
  durationMs  Int?      @map("duration_ms")
  source      String
  note        String?
  adoPushedAt DateTime? @map("ado_pushed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("time_entries")
}

model ActivityLogEntry {
  id        Int      @id @default(autoincrement())
  cardId    Int      @map("card_id")
  eventType String   @map("event_type")
  payload   String?
  createdAt DateTime @default(now()) @map("created_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("activity_log")
}

/// Singleton (id = 1): the one Azure DevOps org connection this local app talks to.
model AzureDevOpsConnection {
  id                   Int       @id @default(1)
  orgUrl               String    @map("org_url")
  pat                  String
  writeMode            String    @default("readonly") @map("write_mode")
  writeAllowedProjects String    @default("[]") @map("write_allowed_projects")
  boardId              Int?      @unique @map("board_id")
  userName             String?   @map("user_name")
  lastSyncedAt         DateTime? @map("last_synced_at")

  board Board? @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@map("ado_connection")
}

/// 1:1 link between a local card and the Azure DevOps work item it mirrors.
model AdoWorkItem {
  cardId          Int      @id @map("card_id")
  adoId           Int      @unique @map("ado_id")
  rev             Int
  project         String
  type            String
  state           String
  stateCategory   String   @map("state_category")
  descriptionHtml String?  @map("description_html")
  url             String
  parentAdoId     Int?     @map("parent_ado_id")
  parentTitle     String?  @map("parent_title")
  parentType      String?  @map("parent_type")
  archivedBySync  Boolean  @default(false) @map("archived_by_sync")
  syncedAt        DateTime @map("synced_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("ado_work_items")
}

/// Per-project cache of a work item type's states, categories and Completed Work support.
model AdoWorkItemType {
  project               String
  name                  String
  color                 String?
  statesJson            String   @map("states_json")
  supportsCompletedWork Boolean  @map("supports_completed_work")
  fetchedAt             DateTime @map("fetched_at")

  @@id([project, name])
  @@map("ado_work_item_types")
}
