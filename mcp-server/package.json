{
  "name": "@clicklocal/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "clicklocal-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
